# ═══════════════════════════════════════════════════════════════════
# Paper 1 Research Artifacts Repository — .gitignore
# IEEE / Academic Reproducibility Standard
# ═══════════════════════════════════════════════════════════════════

# ── Manuscript & Working Document Exclusions ─────────────────────
# Manuscripts and private word processor binaries are strictly excluded
# The paper is submitted and reviewed via official conference/journal portals
*.docx
*.doc
*.pdf
*.pptx
*.odt
extracted_media/
Paper1_Manuscript.md
Paper1_Manuscript.docx
Freight_ETA_IEEE_*.docx

# ── Temporary Editorial & Scratch Patch Scripts ──────────────────
audit_*.py
patch_*.py
*remove_fig8*.py
*fig_renumber*.py
*fig8*.py
inspect_fig_renumber.py

# ── Python Cache & Bytecode ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ─────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE & Operating System ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Testing & Cache ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
